<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <!-- Temporary compatibility for existing save games; replace BinaryFormatter separately. -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <AssemblyName>Burntime</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMGCBItems>false</EnableMGCBItems>
    <SteamworksTargetRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SteamworksTargetRid>
    <SteamworksTargetRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</SteamworksTargetRid>
    <SteamworksManagedPath Condition="'$(SteamworksTargetRid)' == 'osx-arm64'">..\..\third_party\steamworks\managed\osx-linux-arm64\Steamworks.NET.dll</SteamworksManagedPath>
    <SteamworksManagedPath Condition="'$(SteamworksTargetRid)' == 'osx-x64' Or '$(SteamworksTargetRid)' == 'linux-x64'">..\..\third_party\steamworks\managed\osx-linux-x64\Steamworks.NET.dll</SteamworksManagedPath>
    <SteamworksManagedPath Condition="'$(SteamworksTargetRid)' == 'win-x64'">..\..\third_party\steamworks\managed\windows-x64\Steamworks.NET.dll</SteamworksManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <MonoGameContentReference Include="Content/Content.mgcb" OutputFolder="Content" />
    <MonoGameContentReference Include="Content/Shaders.mgcb" OutputFolder="Content"
      Condition="'$(BuildShaders)' == 'true'" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <GetProductVersionCommand>&quot;$(MSBuildProjectDirectory)\get-product-version.bat&quot;</GetProductVersionCommand>
    <GetFileVersionCommand>&quot;$(MSBuildProjectDirectory)\get-file-version.bat&quot;</GetFileVersionCommand>
    <GetSemverVersionCommand>&quot;$(MSBuildProjectDirectory)\get-semver-version.bat&quot;</GetSemverVersionCommand>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <GetProductVersionCommand>sh &quot;$(MSBuildProjectDirectory)/get-product-version.sh&quot;</GetProductVersionCommand>
    <GetFileVersionCommand>sh &quot;$(MSBuildProjectDirectory)/get-file-version.sh&quot;</GetFileVersionCommand>
    <GetSemverVersionCommand>sh &quot;$(MSBuildProjectDirectory)/get-semver-version.sh&quot;</GetSemverVersionCommand>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <BaseOutputPath>..\..\bin</BaseOutputPath>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
    <Authors>Jakob Harder</Authors>
    <Copyright>Jakob Harder</Copyright>
    <Title>Burntime</Title>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- use git describe to set assembly version -->
  <Target Name="SetGitVersion" BeforeTargets="InitializeSourceControlInformation">
    <Exec Command="$(GetProductVersionCommand)" ConsoleToMSBuild="True" IgnoreExitCode="False">
      <Output PropertyName="ProductVersion" TaskParameter="ConsoleOutput" />
    </Exec>
    <Exec Command="$(GetFileVersionCommand)" ConsoleToMSBuild="True" IgnoreExitCode="False">
      <Output PropertyName="FileVersion" TaskParameter="ConsoleOutput" />
    </Exec>
    <Exec Command="$(GetSemverVersionCommand)" ConsoleToMSBuild="True" IgnoreExitCode="False">
      <Output PropertyName="SemverVersion" TaskParameter="ConsoleOutput" />
    </Exec>
    <PropertyGroup>
      <AssemblyVersion>$(FileVersion)</AssemblyVersion> 
      <FileVersion>$(FileVersion)</FileVersion>
      <InformationalVersion>$(ProductVersion)</InformationalVersion>
      <Version>$(SemverVersion)</Version>
    </PropertyGroup>
  </Target>
  
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>$(SteamworksManagedPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Burntime.BurnGfx\Burntime.BurnGfx.csproj" />
    <ProjectReference Include="..\Burntime.Remaster\Burntime.Remaster.csproj" />
    <ProjectReference Include="..\Burntime.Framework\Burntime.Framework.csproj" />
    <ProjectReference Include="..\Burntime.Platform\Burntime.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\resources\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\licenses\**">
      <Link>licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\g*\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(SteamworksTargetRid)' == 'win-x64'">
    <Content Include="..\..\third_party\steamworks\win-x64\steam_api64.dll">
      <Link>steam_api64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(SteamworksTargetRid)' == 'osx-arm64' Or '$(SteamworksTargetRid)' == 'osx-x64'">
    <Content Include="..\..\third_party\steamworks\osx\libsteam_api.dylib">
      <Link>libsteam_api.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(SteamworksTargetRid)' == 'linux-x64'">
    <Content Include="..\..\third_party\steamworks\linux-x64\libsteam_api.so">
      <Link>libsteam_api.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
  <Target Name="ValidateSteamworksManagedTarget" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(SteamworksManagedPath)' == ''"
      Text="Steamworks.NET has no managed build configured for runtime '$(SteamworksTargetRid)'." />
  </Target>
  <Target Name="DeployCompiledShaders" AfterTargets="Build"
    Condition="'$(BuildShaders)' == 'true'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\..\resources\game\classic\shaders" />
    <Copy SourceFiles="$(OutputPath)Content\SharpBilinear.xnb"
      DestinationFiles="$(MSBuildProjectDirectory)\..\..\resources\game\classic\shaders\SharpBilinear.xnb"
      SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)Content\Xbr2.xnb"
      DestinationFiles="$(MSBuildProjectDirectory)\..\..\resources\game\classic\shaders\Xbr2.xnb"
      SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)Content\Xbr2Alpha.xnb"
      DestinationFiles="$(MSBuildProjectDirectory)\..\..\resources\game\classic\shaders\Xbr2Alpha.xnb"
      SkipUnchangedFiles="true" />
  </Target>
  <!--<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PostBuildEvent>
      xcopy $(ProjectDir)..\..\resources\*.txt $(ProjectDir)..\..\bin\Debug\ /Y /E /Q
      xcopy $(ProjectDir)..\..\resources\game\* $(ProjectDir)..\..\bin\Debug\game\ /Y /E /Q
    </PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PostBuildEvent>
      xcopy $(ProjectDir)..\..\resources\*.txt $(ProjectDir)..\..\bin\Release\ /Y /E /Q
      xcopy $(ProjectDir)..\..\resources\game\* $(ProjectDir)..\..\bin\Release\game\ /Y /E /Q
    </PostBuildEvent>
  </PropertyGroup>-->
</Project>
